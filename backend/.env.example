# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Generate a real one for anything beyond local dev, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=insecure-dev-key-change-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Must match the origin the frontend dev server actually runs on (see
# frontend/vite.config.js — default is Vite's own default, :5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173
